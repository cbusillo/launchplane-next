[Unit]
Description=Launchplane
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# A healthy start answers within 1 s. Ten starts in five minutes is a Launchplane that keeps dying, and it is left failed.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=launchplane
WorkingDirectory=/var/lib/launchplane
EnvironmentFile=/etc/launchplane/bed.env
EnvironmentFile=-/etc/launchplane/publisher.env
Environment=LAUNCHPLANE_CONTAINER_HOST_CREDENTIALS=/var/lib/launchplane/tls
Environment=LAUNCHPLANE_LISTEN_ADDRESS=0.0.0.0
Environment=LAUNCHPLANE_LISTEN_PORT=8700
ExecStart=/opt/launchplane/.venv/bin/launchplane
Restart=on-failure

[Install]
WantedBy=multi-user.target
