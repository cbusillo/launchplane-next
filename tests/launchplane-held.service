[Unit]
Description=Launchplane, run by its test harness so that its calls can be held
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
Conflicts=launchplane.service
StartLimitIntervalSec=0

[Service]
User=launchplane
WorkingDirectory=/var/lib/launchplane
EnvironmentFile=/etc/launchplane/bed.env
Environment=LAUNCHPLANE_CONTAINER_HOST_CREDENTIALS=/var/lib/launchplane/tls
Environment=LAUNCHPLANE_LISTEN_ADDRESS=0.0.0.0
Environment=LAUNCHPLANE_LISTEN_PORT=8700
Environment=PYTHONPATH=/opt/launchplane
ExecStart=/opt/launchplane/.venv/bin/python -m tests.held_launchplane
Restart=on-failure
